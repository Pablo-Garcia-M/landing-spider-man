---
/**
 * Botones para compartir.
 *
 * Una landing de estreno vive de que la gente la reenvíe. Los enlaces de
 * WhatsApp y X son "intents" públicos y sin API key: abren la app con el
 * texto precargado, nada más. El botón de copiar usa la Clipboard API con
 * un plan B manual para navegadores/contextos que no la exponen (por
 * ejemplo, http:// sin TLS).
 */
import { PELICULA } from '../data/pelicula.js';

const texto = `${PELICULA.tituloCompleto} — ${PELICULA.estrenoLargo}, solo en cines.`;
const url = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;

const whatsapp = `https://wa.me/?text=${encodeURIComponent(`${texto} ${url}`)}`;
const x = `https://twitter.com/intent/tweet?text=${encodeURIComponent(texto)}&url=${encodeURIComponent(url)}`;
const facebook = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`;
---

<div class="compartir" data-compartir data-url={url}>
  <p class="compartir__etiqueta">Compartir</p>

  <div class="compartir__botones">
    <a
      class="compartir__boton"
      href={whatsapp}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Compartir por WhatsApp"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.1-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1s-.7.8-.9 1c-.2.2-.3.2-.6.1-.2-.1-1-.4-2-1.2-.7-.6-1.2-1.4-1.4-1.7-.1-.2 0-.4.1-.5l.4-.5c.1-.2.2-.3.2-.5.1-.2 0-.4 0-.5-.1-.1-.6-1.4-.8-2-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.3-.2.2-.9.9-.9 2.2s1 2.5 1.1 2.7c.1.2 2 3 4.7 4.2.7.3 1.2.5 1.6.6.7.2 1.3.2 1.8.1.5-.1 1.5-.6 1.8-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z"/></svg>
    </a>

    <a
      class="compartir__boton"
      href={x}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Compartir en X"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13.6 10.6 20.4 3h-1.6l-5.9 6.6L8.2 3H3l7.1 10.1L3 21h1.6l6.2-7 5 7H21l-7.4-10.4Zm-2.2 2.5-.7-1L5 4.3h2.2l4.6 6.4.7 1 6 8.4H16l-4.6-6.6Z"/></svg>
    </a>

    <a
      class="compartir__boton"
      href={facebook}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Compartir en Facebook"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13.5 21v-7.6h2.6l.4-3h-3v-1.9c0-.9.2-1.5 1.5-1.5h1.6V4.2C15.9 4.1 15 4 14 4c-2.2 0-3.7 1.3-3.7 3.8v2.1H7.7v3H10V21h3.5Z"/></svg>
    </a>

    <button type="button" class="compartir__boton compartir__boton--copiar" data-copiar aria-label="Copiar enlace">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 9V4a1 1 0 0 1 1-1h9a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1h-5M6 9h9a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1v-9a1 1 0 0 1 1-1Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
  </div>

  <p class="compartir__aviso" role="status" data-aviso hidden>Enlace copiado</p>
</div>

<style>
  .compartir {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .compartir__etiqueta {
    font-family: var(--mono);
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--luz-tenue);
  }

  .compartir__botones {
    display: flex;
    gap: 0.5rem;
  }

  .compartir__boton {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--borde-fuerte);
    background: transparent;
    color: var(--luz);
    cursor: pointer;
    transition:
      background var(--transicion),
      border-color var(--transicion),
      color var(--transicion),
      transform var(--transicion);
  }

  .compartir__boton svg {
    width: 1.1rem;
    height: 1.1rem;
    fill: currentColor;
  }

  .compartir__boton:hover,
  .compartir__boton:focus-visible {
    background: var(--alba);
    border-color: var(--alba);
    color: var(--noche);
    transform: translateY(-2px);
  }

  .compartir__aviso {
    position: absolute;
    left: 0;
    top: calc(100% + 0.5rem);
    white-space: nowrap;
    font-size: 0.78rem;
    color: var(--alba);
  }
</style>

<script>
  /**
   * Copiar enlace: Clipboard API con plan B para contextos sin `navigator.clipboard`
   * (por ejemplo, servido por http:// sin TLS, donde el navegador no la expone).
   */
  document.querySelectorAll('[data-compartir]').forEach((contenedor) => {
    const boton = contenedor.querySelector('[data-copiar]');
    const aviso = contenedor.querySelector('[data-aviso]');
    const url = contenedor.getAttribute('data-url') || location.href;

    boton?.addEventListener('click', async () => {
      try {
        if (navigator.clipboard) {
          await navigator.clipboard.writeText(url);
        } else {
          const area = document.createElement('textarea');
          area.value = url;
          area.style.position = 'fixed';
          area.style.opacity = '0';
          document.body.appendChild(area);
          area.select();
          document.execCommand('copy');
          area.remove();
        }
        if (aviso) {
          aviso.hidden = false;
          window.setTimeout(() => (aviso.hidden = true), 2500);
        }
      } catch {
        // Si ni siquiera el plan B funciona, no rompemos nada: el resto de
        // los botones de compartir (WhatsApp, X, Facebook) siguen operativos.
      }
    });
  });
</script>
