---
import Entradas from './react/Entradas.jsx';
import { CINES, CIUDADES } from '../data/pelicula.js';
---

<section class="bloque" id="sesiones">
  <div class="bloque__cabecera">
    <p class="eyebrow revelar">Dónde verla</p>
    <h2 class="titulo-seccion revelar" data-retraso="1">Sesiones</h2>
    <p class="parrafo revelar" data-retraso="2">
      Elegí tu ciudad y el formato. El filtrado ocurre en el navegador sobre
      datos que ya viajaron con la página: cambiar de ciudad no dispara ni una
      petición más.
    </p>
  </div>

  <div class="revelar" data-retraso="3">
    <Entradas client:visible ciudades={CIUDADES} cines={CINES} />
  </div>
</section>
