---
import { FAQ } from '../data/pelicula.js';
---

<section class="bloque" id="faq">
  <div class="bloque__cabecera">
    <p class="eyebrow revelar">Antes de que preguntes</p>
    <h2 class="titulo-seccion revelar" data-retraso="1">Dudas</h2>
  </div>

  {/*
    <details> nativo: acordeón accesible por teclado, buscable con Ctrl+F
    incluso plegado y con cero JavaScript. Una librería aquí sería peso muerto.
  */}
  <div class="faq">
    {
      FAQ.map((item) => (
        <details class="faq__item revelar" name="faq">
          <summary class="faq__pregunta">
            <span>{item.pregunta}</span>
            <span class="faq__signo" aria-hidden="true" />
          </summary>
          <p class="faq__respuesta">{item.respuesta}</p>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq {
    border-top: 1px solid var(--borde);
  }

  .faq__item {
    border-bottom: 1px solid var(--borde);
  }

  .faq__pregunta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1.4rem;
    cursor: pointer;
    list-style: none;
    font-family: var(--display);
    font-variation-settings: 'wdth' 88, 'wght' 700;
    font-size: clamp(1rem, 2.2vw, 1.25rem);
    transition: color var(--transicion);
  }

  /* El triángulo por defecto de Safari/Chrome, fuera. */
  .faq__pregunta::-webkit-details-marker {
    display: none;
  }

  .faq__pregunta:hover {
    color: var(--alba);
  }

  /* Cruz construida con dos pseudo-elementos: uno rota y se vuelve un menos. */
  .faq__signo {
    position: relative;
    flex: none;
    width: 1rem;
    height: 1rem;
  }
  .faq__signo::before,
  .faq__signo::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto 0;
    height: 1px;
    background: var(--alba);
    transition: transform var(--transicion);
  }
  .faq__signo::after {
    transform: rotate(90deg);
  }
  .faq__item[open] .faq__signo::after {
    transform: rotate(0deg);
  }

  .faq__respuesta {
    padding-bottom: 1.6rem;
    max-width: 62ch;
    color: var(--luz);
    opacity: 0.82;
  }

  @media (prefers-reduced-motion: no-preference) {
    .faq__item[open] .faq__respuesta {
      animation: desplegar 320ms ease;
    }
    @keyframes desplegar {
      from {
        opacity: 0;
        transform: translateY(-6px);
      }
    }
  }
</style>
