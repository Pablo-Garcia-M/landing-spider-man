---
import '../styles/fuentes.css';
import '../styles/global.css';
import archivoUrl from '../fonts/archivo-variable.woff2?url';
import { PELICULA, CLAVE_ACCESO } from '../data/pelicula.js';

// Props opcionales: { titulo, descripcion }. Si no llegan, se usan los
// valores por defecto de abajo, que es el caso de la home.
const {
  titulo = `${PELICULA.tituloCompleto} — ${PELICULA.estrenoLargo}, solo en cines`,
  descripcion = PELICULA.descripcion,
} = Astro.props;

/**
 * `import.meta.env.BASE_URL` siempre termina en "/" y vale "/" a secas si no
 * hay `base` configurado, o "/landing-spider-man/" en GitHub Pages. Todo lo
 * que vive en public/ (favicon, og.png...) hay que prefijarlo a mano: Astro
 * sólo reescribe con el base las rutas que él procesa (imports, CSS), no un
 * href="/algo" escrito literal en el HTML.
 */
// .replace() en ambos lados: no confiamos en que BASE_URL termine en "/" ni
// en que `ruta` no empiece con una, así siempre queda exactamente una barra
// entre el base y el archivo, sin importar cómo esté escrito cualquiera de los dos.
const base = import.meta.env.BASE_URL;
const conBase = (ruta) => `${base.replace(/\/$/, '')}/${ruta.replace(/^\//, '')}`;

// URL absoluta: las tarjetas de WhatsApp, X y Slack no resuelven rutas relativas.
const canonica = new URL(Astro.url.pathname, Astro.site);
const ogImagen = new URL(conBase('og.png'), Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />
    <meta name="theme-color" content="#0B1026" />

    {/*
      Proyecto de portfolio, no oficial: a propósito NO se busca aparecer en
      buscadores ni quedar asociado a la película real. "noindex" le pide a
      Google/Bing que no la liste ni la guarde en resultados de búsqueda;
      "nofollow" pide que tampoco siga los enlaces de acá para descubrir más
      páginas. Ojo: esto la saca de la búsqueda, no la hace privada — quien
      tenga el link exacto puede entrar igual, porque GitHub Pages no ofrece
      control de acceso.
    */}
    <meta name="robots" content="noindex, nofollow" />

    <link rel="icon" href={conBase('favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={conBase('favicon.ico')} sizes="32x32" />
    <link rel="apple-touch-icon" href={conBase('apple-touch-icon.png')} />

    {/* Cómo se ve el enlace cuando alguien lo comparte. */}
    <meta property="og:type" content="video.movie" />
    <meta property="og:site_name" content={PELICULA.tituloCompleto} />
    <meta property="og:title" content={PELICULA.tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={ogImagen} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="es_ES" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={PELICULA.tituloCompleto} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={ogImagen} />

    {/*
      La variable de Archivo es la fuente del título del hero: lo primero que
      pinta la página. Precargarla evita que el navegador la descubra recién
      al parsear el CSS, un paso más tarde de lo necesario.
    */}
    <link rel="preload" href={archivoUrl} as="font" type="font/woff2" crossorigin />
  </head>

  <body>
    {/*
      Candado de acceso: recordatorio, NO es seguridad real (ver
      CLAVE_ACCESO en pelicula.js). Por defecto, sólo con CSS —sin esperar
      a ningún script—, el overlay se ve y el contenido real queda oculto
      con `display: none`. Así no hay ni un instante de parpadeo donde se
      vea el contenido real antes de taparlo: el estado "bloqueado" es el
      que arranca dibujado, no algo que un script agregue después.
    */}
    <div
      class="candado"
      id="candado"
      role="dialog"
      aria-modal="true"
      aria-labelledby="candado-titulo"
      data-clave={CLAVE_ACCESO}
    >
      <form class="candado__caja">
        <p class="candado__eyebrow">Acceso restringido</p>
        {/* No es <h1>: el título de página (accesibilidad, SEO) sigue
            siendo el del Hero. Esto es sólo el título del diálogo. */}
        <p class="candado__titulo" id="candado-titulo">Todavía no</p>
        <p class="candado__texto">
          Esta página está en revisión. Si te pasaron el enlace, ingresá la
          clave para verla.
        </p>

        <label class="sr-only" for="candado-clave">Clave de acceso</label>
        <input
          class="candado__input"
          id="candado-clave"
          type="password"
          autocomplete="off"
          placeholder="Clave de acceso"
        />

        <button type="submit" class="boton boton--solido candado__boton">Entrar</button>

        <p class="candado__error" role="alert" hidden>Clave incorrecta. Probá de nuevo.</p>
      </form>
    </div>

    {/* El contenido real de cada página vive acá adentro: oculto por CSS
        mientras el candado esté activo (ver global.css, sección CANDADO). */}
    <div id="pagina-real">
      <a class="saltar" href="#contenido">Saltar al contenido</a>
      <slot />
    </div>

    <script>
      /**
       * La clave viaja en el atributo data-clave del propio #candado (ver
       * arriba), no inyectada dentro de este script. Un script con un
       * valor de build interpolado adentro (`define:vars`) cambia de
       * contenido en cada build y no calzaba bien con los hashes
       * automáticos de la CSP (Astro los calcula sobre la plantilla, no
       * siempre sobre el resultado final) — este script, en cambio, es
       * siempre el mismo texto, así que su hash es estable.
       */
      const YA_DESBLOQUEADO = localStorage.getItem('acceso-spiderman') === 'ok';
      if (YA_DESBLOQUEADO) {
        document.documentElement.classList.add('desbloqueado');
      }

      const candado = document.getElementById('candado');
      const formulario = candado?.querySelector('form');
      const input = document.getElementById('candado-clave');
      const error = candado?.querySelector('.candado__error');
      const clave = candado?.dataset.clave ?? '';

      formulario?.addEventListener('submit', (evento) => {
        evento.preventDefault();

        if (input.value.trim().toLowerCase() === clave.toLowerCase()) {
          localStorage.setItem('acceso-spiderman', 'ok');
          document.documentElement.classList.add('desbloqueado');
        } else {
          error.hidden = false;
          input.value = '';
          input.focus();
        }
      });
    </script>

    <script>
      /**
       * Revelado al scroll, una sola vez para toda la página.
       *
       * IntersectionObserver en lugar del evento 'scroll': el navegador avisa
       * cuando el elemento cruza el umbral, en vez de ejecutar código nuestro
       * en cada pixel scrolleado. Y en cuanto un elemento se revela dejamos de
       * observarlo, así el observer se vacía solo a medida que bajás.
       */
      const objetivos = document.querySelectorAll('.revelar');

      const prefiereQuietud = window.matchMedia(
        '(prefers-reduced-motion: reduce)'
      ).matches;

      if (prefiereQuietud || !('IntersectionObserver' in window)) {
        objetivos.forEach((el) => el.classList.add('visible'));
      } else {
        const observador = new IntersectionObserver(
          (entradas) => {
            for (const entrada of entradas) {
              if (!entrada.isIntersecting) continue;
              entrada.target.classList.add('visible');
              observador.unobserve(entrada.target);
            }
          },
          { threshold: 0.12, rootMargin: '0px 0px -60px 0px' }
        );

        objetivos.forEach((el) => observador.observe(el));
      }
    </script>
  </body>
</html>
